{
  "split": "6040",
  "num_samples": 60000,
  "model_config": {
    "name": "Single CVAE - Reduced Regularization",
    "latent_dim": 128,
    "img_size": [
      224,
      128
    ],
    "l2_regularization": 1e-05,
    "dropout_rates": {
      "encoder": 0.05,
      "encoder_dense": 0.15,
      "decoder": 0.1,
      "classifier": 0.5,
      "latent": 0.1
    },
    "learning_rate": 1e-05,
    "loss_weights": {
      "recon": 1.5,
      "kl": 0.02,
      "anomaly": 0.8,
      "focal_alpha": 0.7,
      "focal_gamma": 1.0
    },
    "batch_size": 16,
    "epochs": 5,
    "patience": 1
  }
}